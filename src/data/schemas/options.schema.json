{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Options Screen",
  "type": "object",
  "additionalProperties": false,
  "required": ["template-type", "title", "options"],
  "properties": {
    "template-type": { "const": "options" },
    "image": { "type": "string" },
    "title": { "type": "string" },
    "text": { "type": "string" },
    "nav-bar": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "visible": { "type": "boolean" } }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "target"],
        "properties": {
          "text": { "type": "string" },
          "track": { "type": "boolean" },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["link", "page"] },
              "value": { "type": "string" }
            },
            "if": { "properties": { "type": { "const": "page" } } },
            "then": { "properties": { "value": { "enum": ["title", "project", "start_route", "gallery", "continue"] } } }
          }
        }
      }
    }
  }
}
