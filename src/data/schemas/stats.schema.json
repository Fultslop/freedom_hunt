{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stats",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "prompt": { "type": "string" },
    "footnote": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": ["number", "string"] },
          "label": { "type": "string" },
          "visibility": { "type": "string", "enum": ["visible", "click_to_reveal"] }
        }
      }
    }
  }
}
