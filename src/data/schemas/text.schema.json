{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Text Screen",
  "type": "object",
  "additionalProperties": false,
  "required": ["template-type", "title", "text"],
  "properties": {
    "template-type": { "const": "text" },
    "image": { "type": "string" },
    "title": { "type": "string" },
    "text": { "type": "string" },
    "margin": { "type": "string" }
  }
}
